{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@resident-core/*": ["packages/resident-core/src/*"],
      "@cleaning-core/*": ["packages/cleaning-core/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
